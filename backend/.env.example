# Optional OpenAI-compatible chat organization layer. Without these settings,
# the backend returns deterministic structured data and exact stored text.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Local embedding model. First run may download model weights.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Data paths are relative to the repository root by default.
STANDARD_PROCEDURES_PATH=demo_std_ptc_data/standard_procedures.json
EMERGING_TREATMENTS_PATH=demo_emg_trt_data/emerging_treatments.json
QUERY_TEST_SET_PATH=test_set/queries.json
